# Server Configuration
PORT=3000

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/footlong-blog

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-here

# Client URL (frontend)
CLIENT_URL=http://localhost:5173

# Email Configuration (SMTP)
# For Gmail: Use an App Password (not your regular password)
# For other providers: Use your SMTP credentials

# SMTP Host (e.g., smtp.gmail.com for Gmail)
SMTP_HOST=smtp.gmail.com

# SMTP Port (465 for SSL, 587 for TLS)
SMTP_PORT=465

# Enable SSL/TLS (true for port 465, false for 587)
SMTP_SECURE=true

# SMTP Username (your email address)
SMTP_USER=your-email@gmail.com

# SMTP Password (App Password for Gmail, not your regular password)
SMTP_PASS=your-app-password-here

# Email "From" Settings
EMAIL_FROM=noreply@footlongblog.com
EMAIL_FROM_NAME=FootLong Blog

# Example for Gmail:
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use the App Password as SMTP_PASS
#
# Example for Outlook/Hotmail:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
#
# Example for custom SMTP server:
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=587
# SMTP_SECURE=false